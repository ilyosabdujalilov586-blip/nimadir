# Set GEMINI_API_KEY in Netlify's environment variables before deploying.
GEMINI_API_KEY=replace_with_your_new_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
# Eskiz credentials and OTP signing secret are required for SMS verification.
ESKIZ_EMAIL=replace_with_your_eskiz_account_email
ESKIZ_PASSWORD=replace_with_your_eskiz_api_password
ESKIZ_FROM=replace_with_your_approved_sender_id
OTP_SIGNING_SECRET=replace_with_a_random_secret_of_at_least_32_characters
