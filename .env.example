# Set GEMINI_API_KEY in the deployment platform's environment variables.
GEMINI_API_KEY=replace_with_your_new_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: override the automatically generated session signing key.
# AUTH_SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes

# Must match the OAuth client ID used by Google Identity Services in index.html.
GOOGLE_CLIENT_ID=499001615599-oiaag765cv1uc43no0t34p90krs86kt3.apps.googleusercontent.com

# Gmail account and Google App Password used for registration and login codes.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Required on Vercel for persistent accounts and chat history.
# Netlify Functions use their built-in Blobs credentials automatically.
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
