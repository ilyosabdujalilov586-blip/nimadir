# Set GEMINI_API_KEY in Netlify's environment variables before deploying.
GEMINI_API_KEY=replace_with_your_new_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Generate a random value with at least 32 bytes for signed account sessions.
AUTH_SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes

# Must match the OAuth client ID used by Google Identity Services in index.html.
GOOGLE_CLIENT_ID=499001615599-oiaag765cv1uc43no0t34p90krs86kt3.apps.googleusercontent.com

# For local Netlify Blobs access only; Netlify Functions get these from the platform.
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token
